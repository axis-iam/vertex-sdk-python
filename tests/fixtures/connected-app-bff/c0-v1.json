  "scenarioVectors": [
    {
      "id": "callback-once",
      "steps": [
        "bind prelogin cookie/state/verifier/nonce",
        "consume callback",
        "exchange",
        "repeat same callback"
      ],
      "expected": "one token request; repeat denied",
      "owner": "SDK_REQUIRED"
    },
    {
      "id": "callback-missing-binding",
      "steps": [
        "callback code/state without prelogin cookie"
      ],
      "expected": "deny before exchange",
      "owner": "SDK_REQUIRED"
    },
    {
      "id": "callback-provider-continuation",
      "steps": [
        "bound kind AUTH_CONTINUATION/auth_transaction_id/state",
        "read controlled transaction MFA_REQUIRED"
      ],
      "expected": "safe MFA view; no exchange",
      "owner": "SDK_REQUIRED"
    },
    {
      "id": "callback-provider-code",
      "steps": [
        "bound custom provider code/state"
      ],
      "expected": "backend exchange; no code in browser JSON",
      "owner": "SDK_REQUIRED"
    },
    {
      "id": "callback-denied",
      "steps": [
        "bound error access_denied/state"
      ],
      "expected": "terminate prelogin; no authenticated view",
      "owner": "SDK_REQUIRED"
    },
    {
      "id": "callback-magic-fragment",
      "steps": [
        "AUTH_PROOF/EMAIL_MAGIC_LINK fragment",
        "clear fragment",
        "bound CSRF magic POST"
      ],
      "expected": "exact transaction/identifier/state; consume proof once",
      "owner": "SDK_REQUIRED"
    },
    {
      "id": "callback-mixed-parameters",
      "steps": [
        "code and AUTH_CONTINUATION or duplicate state"
      ],
      "expected": "deny before exchange",
      "owner": "SDK_REQUIRED"
    },
    {
      "id": "refresh-single-owner",
      "steps": [
        "two instances read same generation",
        "both acquire refresh"
      ],
      "expected": "one SEND_INTENT and one HTTP request",
      "owner": "SDK_REQUIRED"
    },
    {
      "id": "refresh-crash-after-intent",
      "steps": [
        "persist SEND_INTENT",
        "crash",
        "lease expires"
      ],
      "expected": "invalidate; never replay previous RT",
      "owner": "SDK_REQUIRED"
    },
    {
      "id": "refresh-before-send-unavailable",
      "steps": [
        "acquire",
        "known failure before intent/send"
      ],
      "expected": "503; release safely; preserve identity",
      "owner": "SDK_REQUIRED"
    },
    {
      "id": "refresh-sent-timeout",
      "steps": [
        "SEND_INTENT",
        "timeout or lost response"
      ],
      "expected": "401 REFRESH_UNCERTAIN; invalidate; no retry",
      "owner": "SDK_REQUIRED"
    },
    {
      "id": "refresh-commit-failed",
      "steps": [
        "SEND_INTENT",
        "new tokens received",
        "provider commit unavailable"
      ],
      "expected": "invalidate/fence old snapshot; no old RT continuation",
      "owner": "SDK_REQUIRED"
    },
    {
      "id": "logout-late-refresh",
      "steps": [
        "refresh owns generation",
        "logout invalidates",
        "refresh commit"
      ],
      "expected": "commit conflict; no resurrection",
      "owner": "SDK_REQUIRED"
    },
    {
      "id": "framework-auto-save",
      "steps": [
        "request A reads session",
        "request B logs out",
        "A automatic save/touch"
      ],
      "expected": "SDK authentication remains invalid; unrelated fields preserved",
      "owner": "SDK_REQUIRED"
    },
    {
      "id": "framework-user-switch",
      "steps": [
        "request A old identity",
        "logout A/login B",
        "A response/save arrives"
      ],
      "expected": "reject A generation; B remains identity",
      "owner": "SDK_REQUIRED"
    },
    {
      "id": "store-read-failure",
      "steps": [
        "provider unavailable"
      ],
      "expected": "503 SESSION_STORE_UNAVAILABLE; not anonymous/empty permissions",
      "owner": "SDK_REQUIRED"
    },
    {
      "id": "validity-dependency-failure",
      "steps": [
        "IAM validity 503"
      ],
      "expected": "503 IAM_UNAVAILABLE; no false revocation",
      "owner": "SDK_REQUIRED"
    },
    {
      "id": "validity-revoked",
      "steps": [
        "IAM validity confirms 401"
      ],
      "expected": "local invalidate; 401 SESSION_INVALIDATED",
      "owner": "SDK_REQUIRED"
    },
    {
      "id": "no-rt-expired",
      "steps": [
        "client/scope does not issue RT",
        "AT expires"
      ],
      "expected": "new authorization; no refresh or fabricated token",
      "owner": "SDK_REQUIRED"
    },
    {
      "id": "logout-valid-at-rt",
      "steps": [
        "local invalidate",
        "POST IAM logout with owned RT"
      ],
      "expected": "SESSION_REVOKED; current AT/session/family",
      "owner": "SDK_REQUIRED"
    },
    {
      "id": "logout-valid-at-no-rt",
      "steps": [
        "local invalidate",
        "POST IAM logout {}"
      ],
      "expected": "SESSION_REVOKED; current AT/session only",
      "owner": "SDK_REQUIRED"
    },
    {
      "id": "logout-expired-at-rt",
      "steps": [
        "local invalidate",
        "POST revoke with client Basic"
      ],
      "expected": "REFRESH_FAMILY_REVOKED; IAM session still present",
      "owner": "SDK_REQUIRED"
    },
    {
      "id": "logout-expired-at-no-rt",
      "steps": [
        "local invalidate",
        "no usable remote credential"
      ],
      "expected": "remote NOT_ATTEMPTED; never refresh for logout",
      "owner": "SDK_REQUIRED"
    },
    {
      "id": "logout-already-revoked",
      "steps": [
        "POST revoke unknown/revoked RT"
      ],
      "expected": "200 protocol result; no expanded session claim",
      "owner": "SDK_REQUIRED"
    },
    {
      "id": "logout-remote-unavailable",
      "steps": [
        "local invalidate succeeds",
        "remote timeout"
      ],
      "expected": "local INVALIDATED cookie CLEARED remote UNCONFIRMED",
      "owner": "SDK_REQUIRED"
    },
    {
      "id": "logout-local-failure",
      "steps": [
        "provider invalidate unavailable",
        "clear cookie"
      ],
      "expected": "503 local UNCONFIRMED; do not claim full logout",
      "owner": "SDK_REQUIRED"
    },
    {
      "id": "csrf-post",
      "steps": [
        "anonymous or authenticated POST with wrong origin/token"
      ],
      "expected": "403 before IAM write",
      "owner": "SDK_REQUIRED"
    },
    {
      "id": "hosted-get",
      "steps": [
        "top-level GET login and callback without custom header"
      ],
      "expected": "prelogin binding validates; navigation can succeed",
      "owner": "SDK_REQUIRED"
    },
    {
      "id": "storage-missing",
      "steps": [
        "server_session configured without provider"
      ],
      "expected": "configuration failure; no automatic memory fallback",
